# Postgres connection
DATABASE_URL=postgres://handy:handy@localhost:5432/handyestate

# Secret used to HMAC OTP codes and NIC numbers. Use a long random string in production.
APP_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for absolute links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMS provider: "console" (dev: prints codes to the server log) — add real gateways in src/server/services/sms.ts
SMS_PROVIDER=console

# Where uploaded images are stored when using the local disk driver
STORAGE_DIR=./storage
